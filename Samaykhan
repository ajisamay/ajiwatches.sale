<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- SEO & Branding -->
    <meta name="description" content="AJI'S WATCHES: Premium leather watches under Rs. 5,000. Luxury craftsmanship based in Quetta.">
    <meta name="author" content="AJI'S PRE DESIGN">
    <title>AJI'S WATCHES | ajiwatches.sale</title>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Lato:wght@300;400;700&display=swap');

        :root {
            --gold: #d4af37;
            --leather: #4e3629;
            --dark: #0a0a0a;
            --card-bg: #161616;
            --cream: #fdfaf5;
        }

        body {
            background-color: var(--dark);
            color: var(--cream);
            font-family: 'Lato', sans-serif;
            margin: 0;
        }

        .announcement-bar {
            background: var(--gold);
            color: black;
            text-align: center;
            padding: 10px;
            font-weight: bold;
            font-size: 0.85rem;
            letter-spacing: 1px;
        }

        header {
            padding: 60px 20px;
            text-align: center;
            border-bottom: 2px solid var(--gold);
            background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://images.unsplash.com/photo-1523170335258-f5ed11844a49?q=80&w=1200');
            background-size: cover;
        }

        .store-name {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            color: var(--gold);
            margin: 0;
            letter-spacing: 8px;
        }

        .tagline {
            letter-spacing: 4px;
            text-transform: uppercase;
            font-size: 0.8rem;
            margin-top: 10px;
        }

        .shop-container {
            max-width: 1100px;
            margin: 50px auto;
            padding: 20px;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 40px;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid #222;
            padding: 25px;
            text-align: center;
            transition: 0.3s;
        }

        .card:hover {
            border-color: var(--gold);
            transform: translateY(-5px);
        }

        .img-box {
            height: 250px;
            background: #000;
            margin-bottom: 20px;
        }

        .img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            margin: 10px 0;
        }

        .price {
            font-size: 1.5rem;
            color: var(--gold);
            font-weight: bold;
            margin: 15px 0;
        }

        .buy-btn {
            width: 100%;
            padding: 12px;
            background: transparent;
            border: 1px solid var(--gold);
            color: var(--gold);
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        .buy-btn:hover {
            background: var(--gold);
            color: black;
        }

        footer {
            padding: 40px;
            text-align: center;
            border-top: 1px solid #222;
            margin-top: 50px;
            color: #666;
        }
    </style>
</head>
<body>

    <div class="announcement-bar">
        FREE DELIVERY IN QUETTA | CASH ON DELIVERY AVAILABLE
    </div>

    <header>
        <h1 class="store-name">AJI'S WATCHES</h1>
        <p class="tagline">Classic Leather • ajiwatches.sale</p>
    </header>

    <main class="shop-container">
        <div class="product-grid">
            
            <div class="card">
                <div class="img-box"><img src="https://img.drz.lazcdn.com/static/pk/p/4d222790c75f3a7c49ac53694f56ea16.jpg" alt="Urban"></div>
                <h3>Urban Classic</h3>
                <p>Clean tan leather for daily wear.</p>
                <p class="price">Rs. 2,850</p>
                <button class="buy-btn" onclick="sendOrder('Urban Classic', '2850')">Order via WhatsApp</button>
            </div>

            <div class="card">
                <div class="img-box"><img src="https://images.unsplash.com/photo-1547996160-81dfa63595aa?q=80&w=600" alt="Shadow"></div>
                <h3>Shadow Minimalist</h3>
                <p>Matte black finish for a bold look.</p>
                <p class="price">Rs. 3,600</p>
                <button class="buy-btn" onclick="sendOrder('Shadow Minimalist', '3600')">Order via WhatsApp</button>
            </div>

            <div class="card" style="border: 1px solid var(--gold);">
                <div class="img-box"><img src="https://img.drz.lazcdn.com/static/pk/p/f29b68d9f485f7a22a3683f2a893630b.jpg" alt="Bolan"></div>
                <h3>Bolan Rugged</h3>
                <p>Quetta's favorite hand-stitched leather.</p>
                <p class="price">Rs. 4,250</p>
                <button class="buy-btn" onclick="sendOrder('Bolan Rugged', '4250')">Order via WhatsApp</button>
            </div>

            <div class="card">
                <div class="img-box"><img src="https://images.unsplash.com/photo-1614164185128-e4ec99c436d7?q=80&w=600" alt="Pacific"></div>
                <h3>Pacific Blue</h3>
                <p>Modern navy grain with silver dial.</p>
                <p class="price">Rs. 4,500</p>
                <button class="buy-btn" onclick="sendOrder('Pacific Blue', '4500')">Order via WhatsApp</button>
            </div>

            <div class="card">
                <div class="img-box"><img src="https://images.unsplash.com/photo-1523170335258-f5ed11844a49?q=80&w=600" alt="Executive"></div>
                <h3>Executive Lite</h3>
                <p>Professional silver-case luxury.</p>
                <p class="price">Rs. 4,750</p>
                <button class="buy-btn" onclick="sendOrder('Executive Lite', '4750')">Order via WhatsApp</button>
            </div>

            <div class="card">
                <div class="img-box"><img src="https://images.unsplash.com/photo-1522312346375-d1a52e2b99b3?q=80&w=600" alt="Royal"></div>
                <h3>Royal Chrono</h3>
                <p>Premium mahogany leather cuff.</p>
                <p class="price">Rs. 4,990</p>
                <button class="buy-btn" onclick="sendOrder('Royal Chrono', '4990')">Order via WhatsApp</button>
            </div>

        </div>
    </main>

    <footer>
        <p>&copy; 2026 AJI'S WATCHES | Designed by AJI'S PRE DESIGN</p>
        <p>Quetta, Pakistan</p>
    </footer>

    <script>
        function sendOrder(name, price) {
            const phone = "YOUR_WHATSAPP_NUMBER"; 
            const message = `Hello Aji! I want to order the ${name} for Rs. ${price}. Please send delivery details for Quetta.`;
            window.open(`https://wa.me/${phone}?text=${encodeURIComponent(message)}`, '_blank');
        }
    </script>
</body>
</html>
